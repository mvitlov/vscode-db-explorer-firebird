{
  "name": "vscode-db-explorer-firebird",
  "displayName": "DB Explorer For Firebird Databases",
  "version": "0.0.4",
  "description": "A tool for exploring and querying Firebird Databases directly inside VS Code.",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "Firebird",
    "Database",
    "DB",
    "RDBMS",
    "FDB",
    "GDB",
    "SQL"
  ],
  "bugs": {
    "url": "https://github.com/mvitlov/vscode-db-explorer-firebird/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mvitlov/vscode-db-explorer-firebird"
  },
  "license": "MIT",
  "author": {
    "name": "Marin Vitlov",
    "url": "https://github.com/mvitlov"
  },
  "publisher": "marinv",
  "main": "./out/extension",
  "scripts": {
    "copy-html": "node -e \"const {cpSync}=require('fs');cpSync('src/result-view/htmlContent','out/result-view/htmlContent',{recursive:true,force:true})\"",
    "compile": "tsc -p ./ && npm run copy-html",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "contributes": {
    "commands": [
      {
        "command": "firebird.explorer.addConnection",
        "title": "Add New Connection",
        "category": "Firebird",
        "icon": {
          "light": "resources/icons/add-connection.svg",
          "dark": "resources/icons/add-connection.svg"
        }
      },
      {
        "command": "firebird.explorer.newSqlDocument",
        "title": "New Sql Query",
        "category": "Firebird",
        "icon": {
          "light": "resources/icons/new-sql.svg",
          "dark": "resources/icons/new-sql.svg"
        }
      },
      {
        "command": "firebird.explorer.refresh",
        "title": "Refresh",
        "category": "Firebird",
        "icon": {
          "light": "resources/icons/refresh.svg",
          "dark": "resources/icons/refresh.svg"
        }
      },
      {
        "command": "firebird.removeHost",
        "title": "Remove Host",
        "category": "Firebird"
      },
      {
        "command": "firebird.setActive",
        "title": "Set Active",
        "category": "Firebird"
      },
      {
        "command": "firebird.chooseActive",
        "title": "Choose Active Database",
        "category": "Firebird"
      },
      {
        "command": "firebird.removeDatabase",
        "title": "Remove Database",
        "category": "Firebird"
      },
      {
        "command": "firebird.showDatabaseInfo",
        "title": "Show Database Info",
        "category": "Firebird"
      },
      {
        "command": "firebird.runQuery",
        "title": "Run SQL Document",
        "category": "Firebird",
        "icon": {
          "light": "resources/icons/light/run-query.svg",
          "dark": "resources/icons/dark/run-query.svg"
        }
      },
      {
        "command": "firebird.runQuerySelection",
        "title": "Run Selected Query",
        "category": "Firebird"
      },
      {
        "command": "firebird.runQueryDocument",
        "title": "Run Entire SQL Document",
        "category": "Firebird"
      },
      {
        "command": "firebird.results.show",
        "title": "Show Query Results",
        "category": "Firebird"
      },
      {
        "command": "firebird.results.clear",
        "title": "Clear Query Results",
        "category": "Firebird"
      },
      {
        "command": "firebird.newQuery",
        "title": "New Query",
        "category": "Firebird"
      },
      {
        "command": "firebird.selectAllRecords",
        "title": "Select All Records",
        "category": "Firebird"
      },
      {
        "command": "firebird.table.previewRecords",
        "title": "Preview Records",
        "category": "Firebird"
      },
      {
        "command": "firebird.table.countRecords",
        "title": "Count Records",
        "category": "Firebird"
      },
      {
        "command": "firebird.table.insertSelectTemplate",
        "title": "Open SELECT Template",
        "category": "Firebird"
      },
      {
        "command": "firebird.table.insertPreviewTemplate",
        "title": "Open Preview Query Template",
        "category": "Firebird"
      },
      {
        "command": "firebird.table.copyName",
        "title": "Copy Table Name",
        "category": "Firebird"
      },
      {
        "command": "firebird.table.dropTable",
        "title": "Drop Table",
        "category": "Firebird"
      },
      {
        "command": "firebird.showTableInfo",
        "title": "Show Table Info",
        "category": "Firebird"
      },
      {
        "command": "firebird.selectFieldRecords",
        "title": "Select All Field Records",
        "category": "Firebird"
      },
      {
        "command": "firebird.view.previewRecords",
        "title": "Preview View Records",
        "category": "Firebird"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Firebird Explorer",
      "properties": {
        "firebird.codeCompletion.keywords": {
          "type": "boolean",
          "default": true,
          "description": "Enable code completion for Firebird-specific keywords."
        },
        "firebird.codeCompletion.database": {
          "type": "boolean",
          "default": true,
          "description": "Enable code completion for Firebird Database table and field names."
        },
        "firebird.logLevel": {
          "type": "string",
          "enum": [
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR"
          ],
          "default": "INFO",
          "description": "Logging level in the output channel."
        },
        "firebird.maxTablesCount": {
          "type": "integer",
          "default": 0,
          "description": "The maximum table count shown in the tree view. Use 0 to show all tables."
        },
        "firebird.recordsPerPage": {
          "type": "string",
          "enum": [
            "50",
            "100",
            "500",
            "1000",
            "All records"
          ],
          "default": "50",
          "description": "Number of records per page to show in results view."
        },
        "firebird.previewRecordLimit": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "description": "Default row limit used by preview actions and generated preview query templates."
        },
        "firebird.maxCellPreviewLength": {
          "type": "integer",
          "default": 120,
          "minimum": 25,
          "description": "Maximum number of characters shown inline for each cell before the result grid truncates the preview."
        }
      }
    },
    "keybindings": [
      {
        "command": "firebird.runQuery",
        "key": "ctrl+alt+q",
        "when": "editorLangId == sql"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "firebird.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation"
        },
        {
          "command": "firebird.runQuerySelection",
          "when": "editorLangId == sql",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "firebird.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation"
        },
        {
          "command": "firebird.runQuerySelection",
          "when": "editorLangId == sql",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "firebird.explorer.addConnection",
          "when": "view == firebird-explorer",
          "group": "navigation@1"
        },
        {
          "command": "firebird.explorer.newSqlDocument",
          "when": "view == firebird-explorer",
          "group": "navigation@2"
        },
        {
          "command": "firebird.explorer.refresh",
          "when": "view == firebird-explorer",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "firebird.removeHost",
          "when": "view == firebird-explorer && viewItem == host",
          "group": "firebird@2"
        },
        {
          "command": "firebird.showDatabaseInfo",
          "when": "view == firebird-explorer && viewItem == database",
          "group": "first@0"
        },
        {
          "command": "firebird.setActive",
          "when": "view == firebird-explorer && viewItem == database",
          "group": "first@1"
        },
        {
          "command": "firebird.newQuery",
          "when": "view == firebird-explorer && viewItem == database",
          "group": "first@2"
        },
        {
          "command": "firebird.removeDatabase",
          "when": "view == firebird-explorer && viewItem == database",
          "group": "second@0"
        },
        {
          "command": "firebird.showTableInfo",
          "when": "view == firebird-explorer && viewItem == table",
          "group": "firebird@1"
        },
        {
          "command": "firebird.table.previewRecords",
          "when": "view == firebird-explorer && viewItem == table",
          "group": "firebird@2"
        },
        {
          "command": "firebird.table.countRecords",
          "when": "view == firebird-explorer && viewItem == table",
          "group": "firebird@3"
        },
        {
          "command": "firebird.table.insertSelectTemplate",
          "when": "view == firebird-explorer && viewItem == table",
          "group": "firebird@4"
        },
        {
          "command": "firebird.table.insertPreviewTemplate",
          "when": "view == firebird-explorer && viewItem == table",
          "group": "firebird@5"
        },
        {
          "command": "firebird.table.copyName",
          "when": "view == firebird-explorer && viewItem == table",
          "group": "firebird@6"
        },
        {
          "command": "firebird.selectAllRecords",
          "when": "view == firebird-explorer && viewItem == table",
          "group": "other@0"
        },
        {
          "command": "firebird.table.dropTable",
          "when": "view == firebird-explorer && viewItem == table",
          "group": "other@1"
        },
        {
          "command": "firebird.selectFieldRecords",
          "when": "view == firebird-explorer && viewItem == field",
          "group": "firebird@0"
        },
        {
          "command": "firebird.view.previewRecords",
          "when": "view == firebird-explorer && viewItem == view",
          "group": "firebird@0"
        }
      ]
    },
    "views": {
      "firebird-tree": [
        {
          "icon": "resources/firebird-explorer-icon.svg",
          "id": "firebird-explorer",
          "name": "DB Explorer"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "firebird-tree",
          "title": "Firebird",
          "icon": "resources/firebird-explorer-icon.svg"
        }
      ]
    }
  },
  "activationEvents": [
    "onLanguage:sql"
  ],
  "dependencies": {
    "ag-grid-enterprise": "^35.2.1",
    "node-firebird": "2.0.2",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/uuid": "11.0.0",
    "@types/vscode": "1.118.0",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "@typescript-eslint/parser": "8.59.1",
    "eslint": "10.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "icon": "resources/img/icon.png",
  "galleryBanner": {
    "color": "#f1c40f",
    "theme": "light"
  }
}
